---
import '../styles/global.css';
import { site } from '../lib/site';

type Props = {
  title?: string;
  description?: string;
  /** When true, ask crawlers not to index (e.g. admin tools). */
  noindex?: boolean;
  /** Wraps the Person schema in a ProfilePage — Google's recommended pattern for personal portfolio homepages. */
  isProfilePage?: boolean;
};

const {
  title = 'Jorge Torres',
  description = `${site.name} — ${site.subtitle}. ${site.location}.`,
  noindex = false,
  isProfilePage = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/media/profile-jorge.png', Astro.site);

const personSchema = {
  '@type': 'Person',
  name: site.name,
  jobTitle: site.subtitle,
  url: Astro.site?.toString(),
  image: ogImageURL.toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.locality,
    addressCountry: site.countryCode,
  },
  email: site.email,
  knowsAbout: site.knowsAbout,
  worksFor: {
    '@type': 'Organization',
    name: site.organization.name,
    url: site.organization.url,
  },
  sameAs: [site.social.youtube, site.social.instagram, site.social.linkedin],
};

const structuredData = isProfilePage
  ? { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: personSchema }
  : { '@context': 'https://schema.org', ...personSchema };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_HN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.ico" />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <div
      id="site-preloader"
      class="fixed inset-0 z-[200] flex items-center justify-center bg-black transition-opacity duration-700"
      aria-hidden="true"
    >
      <span class="font-display preloader-text text-2xl font-semibold tracking-wide text-white opacity-0 md:text-3xl">
        {site.name}
      </span>
    </div>

    <slot />

    <script>
      (function () {
        var el = document.getElementById('site-preloader');
        if (!el) return;

        var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var MIN_VISIBLE_MS = prefersReducedMotion ? 0 : 550;
        var start = Date.now();

        function hide() {
          var wait = Math.max(0, MIN_VISIBLE_MS - (Date.now() - start));
          setTimeout(function () {
            el.style.opacity = '0';
            el.style.pointerEvents = 'none';
            el.addEventListener(
              'transitionend',
              function () {
                el.remove();
              },
              { once: true },
            );
          }, wait);
        }

        if (document.readyState === 'complete') hide();
        else window.addEventListener('load', hide);
      })();
    </script>

    <script>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var ref = params.get('ref');
        if (!ref) return;

        var src = '/ref/' + ref + '.png';
        var img = document.createElement('img');
        img.src = src;
        img.alt = '';
        img.style.position = 'fixed';
        img.style.inset = '0';
        img.style.width = '100%';
        img.style.height = '100%';
        img.style.objectFit = 'cover';
        img.style.pointerEvents = 'none';
        img.style.zIndex = '9999';
        img.style.opacity = '0.35';
        img.style.mixBlendMode = 'normal';
        document.body.appendChild(img);

        var visible = true;
        var opacity = 0.35;

        window.addEventListener('keydown', function (e) {
          if (e.key === 'v') {
            visible = !visible;
            img.style.display = visible ? 'block' : 'none';
          }

          if (e.key === 'o') {
            opacity = Math.min(1, Math.round((opacity + 0.1) * 100) / 100);
            img.style.opacity = String(opacity);
          }

          if (e.key === 'O') {
            opacity = Math.max(0, Math.round((opacity - 0.1) * 100) / 100);
            img.style.opacity = String(opacity);
          }
        });
      })();
    </script>
  </body>
</html>
