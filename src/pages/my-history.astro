---
import Layout from '../layouts/Layout.astro';
import Chrome from '../components/Chrome.astro';
import Stage from '../components/Stage.astro';
import PillNav from '../components/PillNav.astro';
import { site } from '../lib/site';
---

<Layout title={`${site.name} - Mi Historia`} description={`Conoce la historia de ${site.name}, ${site.subtitle.toLowerCase()}.`}>
  <div class="min-h-svh md:h-svh md:overflow-hidden">
    <Chrome />

    <Stage solid class="bg-black md:h-svh" scrollable>
      <PillNav active="history" />
      <div
        class="relative z-20 flex flex-col px-6 pb-32 pt-32 sm:px-10 md:h-full md:justify-center md:px-40 md:pb-0 md:pt-0 lg:px-48 xl:px-56"
      >
        <div class="grid items-center gap-12 md:grid-cols-[280px_1fr] md:gap-24 lg:gap-32">
          <div class="flex justify-center md:justify-start animate-fade-in opacity-0">
            <div class="h-[240px] w-[240px] overflow-hidden rounded-full bg-white/10 md:h-[280px] md:w-[280px] transition-transform duration-500 hover:scale-105">
              <img
                src="/media/profile-jorge.png"
                alt="Jorge Torres"
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
          </div>

          <div class="max-w-[680px] animate-fade-in opacity-0 delay-100">
            <h1 class="font-display text-[36px] font-semibold tracking-tight text-white md:text-[42px]">
              Mi Historia
            </h1>
            <div class="mt-6 space-y-5 text-[15px] leading-[1.7] text-white/85 md:space-y-6">
              <p class="animate-slide-in opacity-0 delay-200">
                Filmmaker y fotógrafo hondureño. Cuatro años construyendo historias visuales para
                marcas High End.
              </p>
              <p class="animate-slide-in opacity-0 delay-300">
                Trabajo en la intersección de la fotografía, el video y el diseño — con un enfoque
                constante por una estética que realmente resalte.
              </p>
              <p class="animate-slide-in opacity-0 delay-300 text-white/70">
                Marcas que han confiado en mi trabajo: UNITEC, IMVESA, EREI WELLNESS, LIVIN,
                NAZARU, MOONLIGHT RUNCLUB, NEW LIFE RUN CLUB, MOLINO HARINERO SULA.
              </p>
              <p class="animate-slide-in opacity-0 delay-400">
                Creo profundamente que cada persona lleva consigo una gran historia. Mi trabajo es
                encontrarla — y asegurarme de contarla como se merece.
              </p>
            </div>
          </div>
        </div>

        <a
          href="https://www.instagram.com/greathumans.mov"
          target="_blank"
          rel="noreferrer"
          class="mt-12 block rounded-[24px] bg-[#3d3d3d] px-10 py-10 shadow-[0_30px_80px_rgba(0,0,0,0.6)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_35px_90px_rgba(0,0,0,0.7)] md:px-14 md:py-12 animate-scale-in opacity-0 delay-400"
        >
          <div class="grid gap-10 md:grid-cols-[1fr_auto_auto] md:items-center md:gap-16 lg:gap-24">
            <div class="max-w-[420px] space-y-4 text-[14px] leading-[1.7] text-white/85">
              <p>
                En 2025 fundé Great Humans — una productora dedicada a contenido deportivo de alto
                nivel.
              </p>
              <p>Creemos que todo atleta ya es un gran ser humano. Nuestro trabajo es demostrarlo.</p>
            </div>

            <div class="flex items-center justify-between md:contents">
              <img
                src="/media/great-humans-logo.png"
                alt="Great Humans"
                class="h-auto w-[180px] md:w-[220px] lg:w-[260px]"
                loading="lazy"
              />

              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
                class="shrink-0 md:justify-self-end"
              >
                <path
                  d="M16.5 3H7.5C5.01472 3 3 5.01472 3 7.5V16.5C3 18.9853 5.01472 21 7.5 21H16.5C18.9853 21 21 18.9853 21 16.5V7.5C21 5.01472 18.9853 3 16.5 3Z"
                  stroke="white"
                  stroke-width="1.6"></path>
                <path
                  d="M12 16.2C14.3196 16.2 16.2 14.3196 16.2 12C16.2 9.68041 14.3196 7.8 12 7.8C9.68041 7.8 7.8 9.68041 7.8 12C7.8 14.3196 9.68041 16.2 12 16.2Z"
                  stroke="white"
                  stroke-width="1.6"></path>
                <path d="M17.25 6.75H17.26" stroke="white" stroke-width="2.2" stroke-linecap="round"
                ></path>
              </svg>
            </div>
          </div>
        </a>
      </div>
    </Stage>
  </div>
</Layout>
