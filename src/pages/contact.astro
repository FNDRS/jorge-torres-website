---
import Layout from '../layouts/Layout.astro';
import Chrome from '../components/Chrome.astro';
import Stage from '../components/Stage.astro';
import PillNav from '../components/PillNav.astro';
import { site } from '../lib/site';
---

<Layout title={`${site.name} - Contacto`} description={`Contacta a ${site.name}, ${site.subtitle.toLowerCase()} en ${site.location}.`}>
  <div class="page relative">
    <Chrome />

    <Stage backgroundImage="/media/contact-bg.png" backgroundPosition="50% 35%">
      <PillNav active="contact" />
      <div class="relative z-20 px-6 pb-36 pt-32 sm:px-10 md:px-16 md:pb-28 md:pt-36">
        <div class="max-w-[560px]">
          <h1 class="font-display text-4xl font-semibold tracking-tight text-white md:text-5xl">
            Conectemos
          </h1>
          <p class="mt-8 text-[14px] leading-relaxed text-white/80">
            Si buscas un socio creativo para explorar nuevas ideas, redefinir tu marca, o crear
            contenido que realmente te distinga - contáctame.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={`mailto:${site.email}`}
              class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-white/95 px-8 text-[14px] font-medium text-neutral-900 shadow-sm transition hover:bg-white"
            >
              Contactar
            </a>
            <a
              href={`mailto:${site.email}`}
              class="text-[14px] font-medium text-white/70 transition hover:text-white hover:underline"
            >
              {site.email}
            </a>
          </div>

          <div class="mt-10 border-t border-white/10 pt-6">
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-white/40">
              ¿Qué incluir en tu correo?
            </p>
            <ul class="mt-3 space-y-2 text-[13px] leading-relaxed text-white/65">
              <li>· Tu nombre y el de tu marca o empresa</li>
              <li>· El asunto o tipo de proyecto que tienes en mente</li>
              <li>· Una breve descripción de lo que buscas</li>
              <li>· Fechas o plazos importantes, si los hay</li>
            </ul>
          </div>
        </div>

        <div
          class="relative z-20 mt-12 flex items-baseline gap-3 text-white/80 md:absolute md:bottom-10 md:right-12 md:mt-0"
        >
          <span class="text-[12px] tracking-wide">Desarrollado por</span>
          <span class="font-display text-[22px] font-semibold tracking-wide">FNDRS</span>
        </div>
      </div>
    </Stage>
  </div>
</Layout>
